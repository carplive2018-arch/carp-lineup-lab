@router.get("/public/recent-batting")
def public_recent_batting(
    request: Request,
    window_games: int = 5,
    view: str | None = None,
):
    try:
        data = _build_recent_batting_response(window_games)
        if _wants_html(request, view):
            return _render_recent_batting_html(data)
        return _no_cache_json(data)
    except Exception as e:
        error = {
            "error": "recent-batting failed",
            "type": e.__class__.__name__,
            "message": str(e),
        }
        if _wants_html(request, view):
            return _html_page("recent-batting failed", f"<pre>{escape(json.dumps(error, ensure_ascii=False))}</pre>")
        return _no_cache_json(error)


